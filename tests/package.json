{
  "name": "afmbridge-tests",
  "version": "1.0.0",
  "description": "Conformance tests for afmbridge OpenRouter-compatible API",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:afmbridge": "TEST_TARGET=afmbridge vitest run",
    "test:openrouter": "TEST_TARGET=openrouter vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^17.2.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "openai": "^4.77.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2",
    "vite@>=8.3 <8.3.3": "8.3.3",
    "vitest@>=4 <4.1.12": "4.1.12",
    "@vitest/mocker@>=4 <4.1.12": "4.1.12",
    "@vitest/browser@>=4 <4.1.12": "4.1.12",
    "@vitest/browser-preview@>=4 <4.1.12": "4.1.12",
    "@vitest/runner@>=4 <4.1.12": "4.1.12",
    "@vitest/expect@>=4 <4.1.12": "4.1.12",
    "@vitest/snapshot@>=4 <4.1.12": "4.1.12",
    "@vitest/utils@>=4 <4.1.12": "4.1.12",
    "@vitest/coverage-v8@>=4 <4.1.12": "4.1.12",
    "@vitest/spy@>=4 <4.1.12": "4.1.12",
    "@vitest/pretty-format@>=4 <4.1.12": "4.1.12",
    "rolldown": "1.2.11"
  }
}
